{
  "name": "interview-prep-max",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test \"**/*.test.js\"",
    "verify:release": "node validate.js --strict && node verify-release.js && node --test release.test.js",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 63",
    "quality:questions": "node question-quality.js --check",
    "quality:questions:report": "node question-quality.js",
    "quality:questions:baseline": "node question-quality.js --write-baseline",
    "quality:questions:fix": "node question-quality.js --fix-positions --write-baseline",
    "test:e2e": "node scripts/run-e2e.js",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.js"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "eslint": "9.37.0"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
