# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env в образ не попадает (.dockerignore) и не коммитится (.gitignore).

# ─── Домен и TLS (обязательно) ───────────────────────────────────────────────
# Без домена Caddy не получит сертификат, а без HTTPS не работает Service
# Worker: PWA не установится и offline-режим будет недоступен.
# Бесплатный вариант — DuckDNS, см. DEPLOY.md.
IPMAX_DOMAIN=ipmax-example.duckdns.org
IPMAX_ACME_EMAIL=you@example.com

# ─── Синхронизация (обязательно) ─────────────────────────────────────────────
# Минимум 24 символа, иначе процесс упадёт на старте.
# Сгенерировать: openssl rand -base64 32
IPMAX_SYNC_TOKEN=

# ─── Правка настроек AI из интерфейса (опционально) ──────────────────────────
# Без этого токена настройки AI можно задать только переменными ниже, а раздел
# «Настройки AI» в приложении сообщит, что правка отключена.
# Токен отдельный от IPMAX_SYNC_TOKEN намеренно: одна утечка не должна давать
# доступ и к прогрессу, и к API-ключу провайдера.
# Сгенерировать: openssl rand -base64 32
IPMAX_ADMIN_TOKEN=

# ─── AI-разбор (опционально) ─────────────────────────────────────────────────
# Значения по умолчанию. Всё это можно задать из интерфейса, если выше задан
# IPMAX_ADMIN_TOKEN; сохранённые из UI настройки перекрывают эти переменные.
# Дефолтный таймаут 15 с мал для тяжёлых моделей — оставьте 45 с.
IPMAX_AI_PROVIDER=
IPMAX_AI_BASE_URL=
IPMAX_AI_MODEL=
IPMAX_AI_API_KEY=
IPMAX_AI_TIMEOUT_MS=45000
